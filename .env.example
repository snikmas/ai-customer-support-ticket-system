# Analyzer selection. Fake mode is the safe default and needs no external key.
ANALYZER_PROVIDER=fake
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_TIMEOUT_SECONDS=20

# Comma-separated browser origins allowed to call FastAPI during local demos.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
