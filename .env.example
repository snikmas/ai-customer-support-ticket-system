# Analyzer selection. Fake mode is the safe default and needs no external key.
ANALYZER_PROVIDER=fake
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_TIMEOUT_SECONDS=20

# Comma-separated browser origins allowed to call FastAPI during local demos.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# JWT signing algorithm used with the mounted RSA key pair.
JWT_ALGORITHM=RS256
# Generate a unique local value; never commit the real secret.
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-secret

# PostgreSQL password used by the Docker Compose `db` service (Stage 7).
# The compose file refuses to start without it.
POSTGRES_PASSWORD=replace-with-a-local-password

# Initial superadmin bootstrap (used by bootstrap_superadmin.py, also via
# `docker compose exec api python bootstrap_superadmin.py`).
SUPERADMIN_NICKNAME=superadmin
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
SUPERADMIN_PHONE=+15550000000
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=replace-with-a-long-local-password

# Local attachment storage. Compose overrides this to /app/uploads.
ATTACHMENTS_DIR=uploads
